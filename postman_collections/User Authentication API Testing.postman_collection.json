		{
			"name": "User Registration",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Registration Successful\",function()\r",
							"{\r",
							" pm.response.to.have.status(200);\r",
							" pm.expect(pm.response.json()).to.have.property(\"token\");\r",
							" pm.environment.set(\"auth_token\", pm.response.json().token);\r",
							"\r",
							"}\r",
							")"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "x-api-key",
